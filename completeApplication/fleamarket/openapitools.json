{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.14.0",
    "generators": {
      "ts-axios-client": {
        "generatorName": "typescript-axios",
        "inputSpec": "http://localhost:8080/v3/api-docs",
        "output": "src/api",
        "additionalProperties": {
          "withSeparateModelsAndApi": true,
          "apiPackage": "apis",
          "modelPackage": "models",
          "supportsES6": true
        }
      }
    }
  }
}
